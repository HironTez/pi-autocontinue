{
  "name": "pi-autocontinue",
  "version": "0.1.0",
  "description": "Resume Pi automatically after a subscription usage window resets",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HironTez/pi-autocontinue.git"
  },
  "homepage": "https://github.com/HironTez/pi-autocontinue#readme",
  "bugs": { "url": "https://github.com/HironTez/pi-autocontinue/issues" },
  "keywords": ["pi-package", "pi-extension", "subscription", "rate-limit"],
  "files": ["src", "README.md", "LICENSE"],
  "pi": { "extensions": ["./src/index.ts"] },
  "scripts": {
    "test": "node --test test/*.test.ts",
