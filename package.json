    "check": "npm run typecheck && npm test",
    "prepack": "npm run check"
  },
  "peerDependencies": { "@earendil-works/pi-coding-agent": ">=1.0.4" },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.4",
